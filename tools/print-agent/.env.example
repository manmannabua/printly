# Copy to .env and fill in the token from the app (Printers → Add agent).
PRINTLY_API_URL=http://localhost:8000
PRINTLY_AGENT_TOKEN=

# How often to poll for new jobs.
POLL_INTERVAL_MS=3000

# virtual = save + log (no real printer needed). lp = send to CUPS `lp` (macOS/Linux).
PRINT_MODE=virtual

# Where downloaded files are spooled.
SPOOL_DIR=./spool
